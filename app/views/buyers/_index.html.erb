<% buyers_present? do %>
  <table class="table table-striped" id="buyers">
    <thead class="thead-dark">
    <tr>
      <th scope="col">Name</th>
      <th scope="col">Company</th>
      <th scope="col">Email</th>
      <th scope="col">Teams</th>
      <th scope="col">Couriers</th>
      <th scope="col">Actions</th>
    </tr>
    </thead>
    <tbody>
      <% @presenter.buyers.each do |buyer| %>
        <tr>
          <td><%= link_to buyer.name, buyer %></td>
          <td><%= buyer.company %></td>
          <td><%= buyer.email %></td>
          <td><%= buyer.teams.size %></td>
          <td><%= buyer.couriers.size %></td>
          <td>
            <%= link_to '', edit_buyer_path(buyer), remote: true, data: { toggle: "modal", target: "#modal-window" }, class: 'fa fa-edit' %>
            <%= link_to '', buyer, method: :delete, data: { confirm: 'Are you sure?' }, class: 'fa fa-trash' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% no_buyers_present? do %>
  <b>No vendors yet</b>
<% end %>

<script type="text/javascript">

  $('#buyers').DataTable( {
    scrollY: 450,
    orderCellsTop: true,
    fixedColumns: true,
    fixedHeader: true,
    width: 100
  } );
</script>