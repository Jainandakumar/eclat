<style type="text/css">
    .full-height {
        min-height: 60vh;
        display: flex;
        flex-direction: column;
    }
    table tbody {
        display: block;
        max-height: 60vh;
        overflow-y: scroll;
    }
    table thead, table tbody tr {
        display: table;
        width: 100%;
        table-layout: fixed;
    }
    .card-body {
        max-height: 300px;
        overflow-y: auto;
    }
</style>

<div id="message"></div>
<button class='btn btn-black btn-sm mb-10 send-reminder-mail' id="send_reminder_mail">Send reminder mail</button>
<div class="full-height">
    <div class="container my-4">
      <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle bg-white shadow-sm">
          <thead class="thead-dark">
          <tr>
            <th scope="col" class="text-center align-middle" style="width: 18%;">Description</th>
            <th scope="col" class="text-center align-middle" style="width: 15%;">Sample Type</th>
            <th scope="col" class="text-center align-middle" style="width: 15%;">Samples</th>
            <th scope="col" class="text-center align-middle" style="width: 15%;">Image</th>
            <th scope="col" class="text-center align-middle" style="width: 37%;">Remarks</th>
          </tr>
          </thead>
          <tbody>
          <% @presenter.return_pbc_rm.each do |item_hash| %>
            <tr class="table-secondary">
              <td colspan="6" class="p-2">
                <div class="d-flex justify-content-between align-items-center">
                  <div>
                    <strong>Airway Bill:</strong> <%= item_hash[:courier].airway_bill_number %>
                  </div>
                  <div>
                    <strong>No of items:</strong> <%= item_hash[:items].size %>
                  </div>
                  <div>
                    <strong>Delivered:</strong> <%= delivery_date_display(item_hash[:courier]) %>
                  </div>
                </div>
              </td>
            </tr>
            <% item_hash[:items].each do |item| %>
              <tr>
                <td class="align-middle" style="width: 18%;"><strong><%= item[:description] %></strong></td>
                <td class="align-middle" style="width: 15%;"><%= item[:sample_type_name] %></td>
                <td class="align-middle text-center" style="width: 15%;"><%= item[:number_of_samples] %></td>
                <td class="align-middle text-center" style="width: 15%;">
                  <% if item[:item_image] %>
                    <%= image_tag item[:item_image], class: "img-thumbnail", style: "max-width: 70px; max-height: 70px;" %>
                  <% else %>
                    <span class="text-muted">No Preview</span>
                  <% end %>
                </td>
                <td class="align-middle" style="width: 37%;">
                  <%= text_field_tag "items[#{item[:id]}][remarks]", ((item[:remarks].nil? || item[:remarks] == 'NA') ? '' : item[:remarks]), class: "form-control remarks", placeholder: "Remarks" %>
                </td>
              </tr>
            <% end %>
          <% end %>
          </tbody>
        </table>
      </div>
      <%= hidden_field_tag 'buyer_id', @buyer.id %>
    </div>
</div>

<script type="text/javascript">

    $('#pending_comments_table_id thead tr').clone(true).appendTo( '#pending_comments_table_id thead' );
    $('#pending_comments_table_id thead tr:eq(1) th').each( function (i) {
        var title = $(this).text();
        $(this).html( '<input type="text" placeholder="Search '+title+'" />' );

        $( 'input', this ).on( 'keyup change', function () {
            if ( table.column(i).search() !== this.value ) {
                table
                    .column(i)
                    .search( this.value )
                    .draw();
            }
        } );
    } );
    var table = $('#pending_comments_table_id').DataTable( {
        scrollY: 450,
        orderCellsTop: true,
        fixedColumns: true,
        fixedHeader: true,
        scrollX: true,
        width: 100,
        columnDefs : [{"targets":4, "type":"date-eu"}],
        order: [4, 'desc']
    } );

    $('#send_reminder_mail').click(function() {
        const remarks = $('.remarks').map(function() {
            return { [$(this).attr('id').split('_')[1]]: this.value };
        }).get();

        $.ajax({
            url: "/send_reminder_mail",
            method: "GET",
            dataType: "json",
            data: { id: <%= @buyer.id %>, from: 'pending_buyer_comments_buyer', remarks },
            error: function(xhr, status, error) {
                console.error(`AJAX Error: ${status} ${error}`);
            },
            success: function(response) {
                $('#message').append(
                    `<div class="alert alert-success alert-dismissable">
          <button type="button" class="close" data-dismiss="alert">
            <span aria-hidden="true">&times;</span>
            <span class="sr-only">Close</span>
          </button>
          ${response.notice}
        </div>`
                );
                $('.remarks').val('');
            }
        });
    });

</script>