<style type="text/css">
    .full-height {
        min-height: 70vh;
        display: flex;
        flex-direction: column;
    }
    table tbody {
        display: block;
        max-height: 70vh;
        overflow-y: scroll;
    }
    table thead, table tbody tr {
        display: table;
        width: 100%;
        table-layout: fixed;
    }
</style>

<div class="full-height">
  <% if @presenter.has_items %>
    <div class="mt-20">
      <table class="table table-striped" id="courier_items">
        <thead class="thead-dark">
        <tr>
          <th scope="col">S.No</th>
          <th scope="col">Sample Type</th>
          <th scope="col">Description</th>
          <th scope="col">No of samples</th>
          <th scope="col">Photo</th>
          <th scope="col">Vendor comments</th>
          <th scope="col">Actions</th>
        </tr>
        </thead>
        <tbody>
        <% @presenter.items.each do |item| %>
          <tr>
            <td><%= item['serial_number'] %></td>
            <td><%= item['sample_type'] %></td>
            <td><%= item['description'] %></td>
            <td><%= item['number_of_samples'] %></td>
            <% if item['image'] %>
              <td><%= image_tag item['image'] %></td>
            <% else %>
              <td>No Preview available</td>
            <% end %>
            <td><%= item['buyer_comments'] %></td>
            <% if @presenter.approved%>
              <td>
                <i class="fa fa-edit text-danger" disabled></i>
                <i class="fa fa-trash text-danger" disabled></i>
              </td>
            <% else%>
              <td>
                <%= link_to '', edit_buyer_courier_item_path(@buyer, @courier, item['id'], courier_show_page: true), {remote: true, 'data-toggle' =>  "modal", 'data-target' => '#modal-window', class: 'fa fa-edit'} %>
                <%= link_to '', buyer_courier_item_path(@buyer, @courier, item['id']), method: :delete, data: { confirm: 'Are you sure?' }, class: 'fa fa-trash' %>
              </td>
            <% end %>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <b>No items yet</b>
  <% end %>
</div>

<script type="text/javascript">

    $('#courier_items').DataTable({
        orderCellsTop: true,
        fixedHeader: true,
        paging: true,
        searching: true,
        info: true
    });
</script>