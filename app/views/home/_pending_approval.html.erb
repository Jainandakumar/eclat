<style type="text/css">
    .full-height {
        min-height: 70vh;
        display: flex;
        flex-direction: column;
    }
    table tbody {
        display: block;
        max-height: 70vh;
        overflow-y: scroll;
    }
    table thead, table tbody tr {
        display: table;
        width: 100%;
        table-layout: fixed;
    }
</style>

<div class="full-height">
  <% if @presenter.return_pba.present? %>
    <table class="table table-striped" id="pending_approval_table_id" style="font-size: 13px;">
      <thead class="thead-dark">
      <tr>
        <th scope="col">Vendor</th>
        <th scope="col">Airway bill</th>
        <th scope="col">Team</th>
        <th scope="col">No of items</th>
        <th scope="col">Delivery On</th>
      </tr>
      </thead>
      <tbody>
      <% @presenter.return_pba.each do |courier| %>
        <tr>
          <td><%= courier[:buyer_name] %></td>
          <td><%= link_to courier[:airway_bill_number], pending_buyer_approval_buyer_path(courier[:buyer_id], courier_id: courier[:id]) %></td>
          <td><%= courier[:team] %></td>
          <td><%= courier[:no_of_items] %></td>
          <td><%= date_display(courier[:delivery_date]) %></td>
        </tr>
      <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="col-12">
      <div class="alert alert-info text-center"><b>No pending items</b></div>
    </div>
  <% end %>
</div>

<script type="text/javascript">

    $('#pending_approval_table_id thead tr').clone(true).appendTo( '#pending_approval_table_id thead' );
    $('#pending_approval_table_id thead tr:eq(1) th').each( function (i) {
        var title = $(this).text();
        $(this).html( '<input type="text" placeholder="Search '+title+'" />' );

        $( 'input', this ).on( 'keyup change', function () {
            if ( table.column(i).search() !== this.value ) {
                table
                    .column(i)
                    .search( this.value )
                    .draw();
            }
        } );
    } );
    var table = $('#pending_approval_table_id').DataTable( {
        scrollY: 450,
        orderCellsTop: true,
        fixedColumns: true,
        fixedHeader: true,
        scrollX: true,
        width: 100,
        columnDefs : [{"targets":4, "type":"date-eu"}],
        order: [4, 'desc']
    } );
</script>